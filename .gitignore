*/[Dd]esktop.ini
[Tt]humbs.db
*/[Tt]humbs.db
ehthumbs*.db
folder.htt
$RECYCLE.BIN/
.DS_Store
*/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.tmp
*.~tmp
*.~*
*.crdownload
*.part

# ------------------------------------------------------------------------------
# 2. Cloud Sync Artifacts (ไฟล์ขยะจากการซิงค์คลาวด์)
# ------------------------------------------------------------------------------
.tmp.driveupload/
*.tmp.driveupload/
*.tmp.driveupload
.tmp.drivedownload/
*.tmp.drivedownload/
*.tmp.drivedownload
Sync_GitHub.log
*.log

# ------------------------------------------------------------------------------
# 3. Python Cache & Bytecode (ไฟล์แคชของไพธอน)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyc

# ------------------------------------------------------------------------------
